                }
              ],
              "cookie": [],
              "body": "[\n  {\n    \"id\": \"b4f9c201-8b19-480c-8396-39185d7913b3\",\n    \"orderRef\": \"WPT-B4F9C201\",\n    \"outletId\": \"OUT001\",\n    \"productBrand\": \"FRESH\",\n    \"itemDescription\": \"Chilled crates\",\n    \"orderDate\": \"2026-10-04\",\n    \"afterCutoff\": false,\n    \"tempRequirement\": \"CHILLED\",\n    \"units\": 20,\n    \"weightKg\": 100,\n    \"volumeM3\": 1.5,\n    \"status\": \"PLACED\"\n  }\n]"
            }
          ]
        }
      ]
    },
    {
      "name": "Planning",
      "item": [
        {
          "name": "Run allocation plan",
          "description": "Requires DISPATCHER or ADMIN. Dispatcher access is restricted to their assigned depot. Creates a draft plan, trips, trip stops, and deferral records.",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"depotId\": \"{{depotId}}\",\n  \"planDate\": \"{{orderDate}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/v1/plans/run"
          },
          "response": [
            {
              "name": "201 Plan created",
              "status": "Created",
